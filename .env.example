# Supabase local database
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# Supabase SSR auth (public browser-safe vars)
PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key

# E2E deterministic seed helper (service role is server-only)
E2E_SUPABASE_URL=http://127.0.0.1:54321
E2E_SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key

# PonchoPay placeholders (replace with real integration values)
PONCHOPAY_API_BASE_URL=https://api.ponchopay.example
PONCHOPAY_API_KEY=ponchopay_secret_key
PONCHOPAY_WEBHOOK_SECRET=ponchopay_webhook_secret
PONCHOPAY_ACCOUNT_ID=poncho_account_id
